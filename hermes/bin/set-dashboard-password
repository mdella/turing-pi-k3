#!/home/ubuntu/.hermes/hermes-agent/venv/bin/python
"""Set (or change) the Hermes dashboard login, then expose the dashboard on all interfaces.

Run in an interactive terminal on node1 as ubuntu:   ~/.hermes/bin/set-dashboard-password
- prompts for username + password (hidden, asked twice); stores ONLY the scrypt hash
  (dashboard.basic_auth.password_hash) plus a random signing secret in ~/.hermes/config.yaml (0600)
- switches hermes-dashboard.service from 127.0.0.1 to 0.0.0.0:9119 and restarts it (sudo)
Changing the password later: run it again (existing browser sessions are signed out because the secret rotates).
"""
import getpass, os, re, secrets, subprocess, sys, time, urllib.request

sys.path.insert(0, "/home/ubuntu/.hermes/hermes-agent")
from plugins.dashboard_auth.basic import hash_password  # noqa: E402

CFG = "/home/ubuntu/.hermes/config.yaml"
UNIT = "/etc/systemd/system/hermes-dashboard.service"


def main():
    if not sys.stdin.isatty():
        sys.exit("Run this in an interactive terminal (it prompts for a hidden password).")
    user = input("Dashboard username [mdella]: ").strip() or "mdella"
    while True:
        pw = getpass.getpass("New password (min 12 chars): ")
        if len(pw) < 12:
            print("  too short — the dashboard is reachable from the whole LAN; use 12+ characters"); continue
        if getpass.getpass("Repeat password: ") != pw:
            print("  passwords differ, try again"); continue
        break
    h = hash_password(pw); del pw
    secret = secrets.token_hex(32)

    text = open(CFG).read()
    block = ("dashboard:\n"
             "  # Password login (scrypt hash only; set via ~/.hermes/bin/set-dashboard-password)\n"
             "  basic_auth:\n"
             f"    username: '{user}'\n"
             f"    password_hash: '{h}'\n"
             f"    secret: '{secret}'\n")
    pat = re.compile(r"^dashboard:\n(?:[ \t].*\n|\n)*", re.M)
    text = pat.sub(block, text, count=1) if pat.search(text) else text.rstrip("\n") + "\n\n" + block
    with open(CFG, "w") as f:
        f.write(text)
    os.chmod(CFG, 0o600)
    print(f"saved: user '{user}', password hash + signing secret in {CFG}")

    subprocess.run(["sudo", "sed", "-i", "s/--host 127.0.0.1/--host 0.0.0.0/", UNIT], check=True)
    subprocess.run(["sudo", "systemctl", "daemon-reload"], check=True)
    subprocess.run(["sudo", "systemctl", "restart", "hermes-dashboard"], check=True)
    for _ in range(24):
        time.sleep(5)
        try:
            code = urllib.request.urlopen("http://192.168.4.101:9119/", timeout=5).status
            break
        except urllib.error.HTTPError as e:
            code = e.code; break
        except Exception:
            code = None
    state = subprocess.run(["systemctl", "is-active", "hermes-dashboard"], capture_output=True, text=True).stdout.strip()
    print(f"hermes-dashboard: {state}; http://192.168.4.101:9119 answered {code}")
    print("Open http://192.168.4.101:9119 (LAN) or http://100.101.160.239:9119 (netbird) and log in.")


if __name__ == "__main__":
    main()
